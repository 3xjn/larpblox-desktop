{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Larpblox",
  "version": "0.1.4",
  "identifier": "dev.3xjn.larpblox",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Larpblox",
        "width": 460,
        "height": 440,
        "resizable": false,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQTI0QjBGRTZBMkI3MTgKUldRWXQ2TG1EMHVpVGFkbG13WG9ESEpoNElLMm9KV2NxWFhIOVE4UFJCNHlZdUdhVXE2TFNNVG0K",
      "endpoints": [
        "https://github.com/3xjn/larpblox-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
